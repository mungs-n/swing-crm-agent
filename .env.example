# 이 파일을 .env 로 복사한 뒤 실제 값을 입력하세요
# cp .env.example .env

# Claude API 키 (AI 인사이트, 캠페인 카피 생성)
ANTHROPIC_API_KEY=

# SendGrid API 키 (캠페인 이메일 발송)
SENDGRID_API_KEY=

# SendGrid에 등록된 발신 이메일 주소
FROM_EMAIL=

# Supabase 프로젝트 URL (예: https://xxxxx.supabase.co)
SUPABASE_URL=

# Supabase service_role API 키 (Project Settings > API 에서 확인)
SUPABASE_SERVICE_ROLE_KEY=

# true로 설정하면 로컬 개발 중 로그인 화면 없이 데이터셋 선택만으로 바로 들어갈 수 있다.
# 배포 환경에는 설정하지 않아서 실제 데모에서는 로그인이 그대로 유지되게 한다.
SKIP_LOGIN=false
